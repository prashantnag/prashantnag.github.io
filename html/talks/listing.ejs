```{=html}

<%
// Multi-day talks set `end-date:`; show "November 21 \u2013 25, 2019" style ranges
function parseDay(v) {
  if (v instanceof Date) return new Date(Date.UTC(v.getUTCFullYear(), v.getUTCMonth(), v.getUTCDate()));
  const s = String(v || "").trim();
  const iso = s.match(/^(\d{4})-(\d{2})-(\d{2})/);
  if (iso) return new Date(Date.UTC(+iso[1], +iso[2] - 1, +iso[3]));
  const d = new Date(s);
  return isNaN(d) ? null : new Date(Date.UTC(d.getFullYear(), d.getMonth(), d.getDate()));
}
function dateRange(talk) {
  const end = parseDay(talk["end-date"]);
  const start = parseDay(talk.date);
  if (!end || !start || end <= start) return talk.date;
  const month = d => d.toLocaleDateString("en-US", { month: "long", timeZone: "UTC" });
  const sd = start.getUTCDate(), ed = end.getUTCDate();
  const sy = start.getUTCFullYear(), ey = end.getUTCFullYear();
  if (sy !== ey) return `${month(start)} ${sd}, ${sy} \u2013 ${month(end)} ${ed}, ${ey}`;
  if (start.getUTCMonth() !== end.getUTCMonth()) return `${month(start)} ${sd} \u2013 ${month(end)} ${ed}, ${ey}`;
  return `${month(start)} ${sd} \u2013 ${ed}, ${ey}`;
}
%>
<div class="talks">
    <% for (const talk of items) { %>
    <div class="talk-entry">
        <div class="metadata">          
            <p class="date"><%= dateRange(talk) %></p>
            <% if (talk.type) { %><span class="talk-type"><%= talk.type %></span><% } %>
        </div>
        <div class="body">
            <p class="title"><%= talk.title %></p>
            <p class="description"><%= talk.description %> | <%= talk.location %></p>

            <% if (talk.links) { %>
            <ul class="talk-links">
                <% for (const link of talk.links) { %>
                <li class="talk-link">
                    <% if (link.local) { %>
                    <a href="<%- talk.path.substring(0, talk.path.lastIndexOf('/')) %>/<%- link.url %>">
                    <% } else { %>
                    <a href="<%- link.url %>">
                    <% } %>
                        <i class="<%- link.icon %>"></i> <%= link.name %>
                    </a>
                </li>
                <% } %>
            <% } %>
            </ul>
        </div>
    </div>
    <% } %>
</div>
```
