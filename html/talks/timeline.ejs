```{=html}
<%
function escapeHtml(s) {
  return String(s == null ? "" : s)
    .replace(/&/g, "&amp;")
    .replace(/</g, "&lt;")
    .replace(/>/g, "&gt;")
    .replace(/\"/g, "&quot;")
    .replace(/'/g, "&#39;");
}

function safeUrl(s) {
  const url = String(s == null ? "" : s).trim();
  if (!url) return "";
  if (/^(?:https?:|mailto:|\/|#)/i.test(url)) return url;
  return "";
}

function toYear(item) {
  const raw = String(item.date || "");
  const year = raw.slice(0, 4);
  return /^\d{4}$/.test(year) ? year : "Unknown";
}

function formatDate(item) {
  const raw = String(item.date || "");
  if (!raw) return "";
  const parsed = new Date(raw);
  if (!isNaN(parsed.getTime())) {
    return parsed.toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric" });
  }
  return raw;
}

function localHref(item, link) {
  if (!link || !link.url) return "";
  if (!link.local) return safeUrl(link.url);
  const base = String(item.path || "");
  const idx = base.lastIndexOf("/");
  return idx >= 0 ? `${base.substring(0, idx)}/${link.url}` : safeUrl(link.url);
}

const groups = new Map();
for (const item of items) {
  const y = toYear(item);
  if (!groups.has(y)) groups.set(y, []);
  groups.get(y).push(item);
}

const years = [...groups.keys()].sort((a, b) => {
  if (a === "Unknown") return 1;
  if (b === "Unknown") return -1;
  return Number(b) - Number(a);
});
%>
<section class="timeline-listing timeline-listing-talks">
  <nav class="timeline-nav" aria-label="Talks timeline">
    <ol class="timeline-nav-list">
<% for (const year of [...years].reverse()) { const count = groups.get(year).length; %>
      <li class="timeline-nav-item">
        <a class="timeline-nav-link" href="#talk-year-<%- year %>">
          <span class="timeline-nav-year"><%- year %></span>
          <span class="timeline-nav-count"><%- count %></span>
        </a>
      </li>
<% } %>
    </ol>
  </nav>

<% for (const year of years) {
  const entries = groups.get(year);
%>
  <section id="talk-year-<%- year %>" class="timeline-year-block">
    <h2 class="timeline-year-title no-anchor">
      <span><%- year %></span>
      <span class="timeline-year-total"><%- entries.length %> talk<%- entries.length === 1 ? "" : "s" %></span>
    </h2>
    <ul class="timeline-cards">
<% for (const talk of entries) {
  const links = Array.isArray(talk.links) ? talk.links : [];
%>
      <li class="timeline-card timeline-card-talk">
        <div class="timeline-card-head">
          <span class="timeline-badge">Talk</span>
          <time class="timeline-date"><%- formatDate(talk) %></time>
        </div>
        <div class="timeline-card-body">
          <p class="timeline-title"><strong><%- escapeHtml(talk.title || "Untitled") %></strong></p>
          <p class="timeline-meta"><%- escapeHtml(talk.description || "") %></p>
          <p class="timeline-meta timeline-location"><i class="fa-solid fa-location-dot"></i> <%- escapeHtml(talk.location || "") %></p>
<% if (links.length > 0) { %>
          <div class="timeline-actions">
<% for (const link of links) {
  const href = localHref(talk, link);
  if (!href) continue;
%>
            <a href="<%- href %>"><i class="<%- link.icon || "fa-solid fa-link" %>"></i> <%- escapeHtml(link.name || "Link") %></a>
<% } %>
          </div>
<% } %>
        </div>
      </li>
<% } %>
    </ul>
  </section>
<% } %>
</section>
```