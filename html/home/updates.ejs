<ul class="recent-updates">
  <% for (const item of items) { %>
    <li><% if (item.path || item.href) { %><a href="<%- item.path || item.href %>" class="recent-updates-title"><%- item.title %></a><% } else { %><span class="recent-updates-title"><%- item.title %></span><% } %><% if (item.date) { %> (<%- item.date %>)<% } %></li>
  <% } %>
</ul>
