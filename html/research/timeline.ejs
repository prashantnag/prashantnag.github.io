```{=html}
<%
function escapeHtml(s) {
  return String(s == null ? "" : s)
    .replace(/&/g, "&amp;")
    .replace(/</g, "&lt;")
    .replace(/>/g, "&gt;")
    .replace(/\"/g, "&quot;")
    .replace(/'/g, "&#39;");
}

function safeUrl(s) {
  const url = String(s == null ? "" : s).trim();
  if (!url) return "";
  if (/^(?:https?:|mailto:|\/|#)/i.test(url)) return url;
  return "";
}

function toYear(item) {
  const date = item.date || item.year || "";
  const year = String(date).slice(0, 4);
  return /^\d{4}$/.test(year) ? year : "Unknown";
}

function formatDate(item) {
  const raw = String(item.date || item.year || "");
  if (!raw) return "";
  const parsed = new Date(raw);
  if (!isNaN(parsed.getTime())) {
    return parsed.toLocaleDateString("en-US", { year: "numeric", month: "long" });
  }
  return raw;
}

function publicationType(item) {
  const path = String(item.path || "");
  const status = String(item.status || "").toLowerCase();
  if (path.includes("/conferences/")) return "Conference";
  if (path.includes("/chapters/")) return "Book Chapter";
  if (status === "preprint") return "Preprint";
  return "Article";
}

function localHref(item, link) {
  if (!link || !link.url) return "";
  if (!link.local) return safeUrl(link.url);
  const base = String(item.path || "");
  const idx = base.lastIndexOf("/");
  return idx >= 0 ? `${base.substring(0, idx)}/${link.url}` : safeUrl(link.url);
}

const groups = new Map();
for (const item of items) {
  const y = toYear(item);
  if (!groups.has(y)) groups.set(y, []);
  groups.get(y).push(item);
}

const years = [...groups.keys()].sort((a, b) => {
  if (a === "Unknown") return 1;
  if (b === "Unknown") return -1;
  return Number(b) - Number(a);
});
%>
<section class="timeline-listing timeline-listing-publications">
  <nav class="timeline-nav" aria-label="Publications timeline">
    <ol class="timeline-nav-list">
<% for (const year of [...years].reverse()) { const count = groups.get(year).length; %>
      <li class="timeline-nav-item">
        <a class="timeline-nav-link" href="#pub-year-<%- year %>">
          <span class="timeline-nav-year"><%- year %></span>
          <span class="timeline-nav-count"><%- count %></span>
        </a>
      </li>
<% } %>
    </ol>
  </nav>

<% for (const year of years) {
  const entries = groups.get(year);
%>
  <section id="pub-year-<%- year %>" class="timeline-year-block">
    <h2 class="timeline-year-title no-anchor">
      <span><%- year %></span>
      <span class="timeline-year-total"><%- entries.length %> publication<%- entries.length === 1 ? "" : "s" %></span>
    </h2>
    <ul class="timeline-cards">
<% for (const item of entries) {
  const pubInfo = item["pub-info"] || {};
  const links = Array.isArray(pubInfo.links) ? pubInfo.links : [];
  const details = safeUrl(item.path || "");
%>
      <li class="timeline-card timeline-card-publication">
        <div class="timeline-card-head">
          <span class="timeline-badge"><%- publicationType(item) %></span>
          <time class="timeline-date"><%- formatDate(item) %></time>
        </div>
        <div class="timeline-card-body">
<% if (pubInfo.reference) { %>
          <p class="timeline-reference"><%- pubInfo.reference %></p>
<% } else { %>
          <p class="timeline-reference"><strong><%- escapeHtml(item.title || "Untitled") %></strong></p>
<% } %>
          <div class="timeline-actions">
<% if (details) { %>
            <a href="<%- details %>"><i class="fa-solid fa-circle-info"></i> Full details</a>
<% } %>
<% for (const link of links) {
  const href = localHref(item, link);
  if (!href) continue;
%>
            <a href="<%- href %>"><i class="<%- link.icon || "fa-solid fa-link" %>"></i> <%- escapeHtml(link.name || "Link") %></a>
<% } %>
          </div>
        </div>
      </li>
<% } %>
    </ul>
  </section>
<% } %>
</section>
```